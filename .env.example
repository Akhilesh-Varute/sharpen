# Turso (SQLite) database
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# The PIN you type in on your phone/PC to unlock Sharpen. Pick something
# longer than a bank PIN since this isn't rate-limited yet — 6-8 digits
# or a short word+number is fine.
APP_PIN=change-me

# Random long string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
APP_SECRET=change-me-too
